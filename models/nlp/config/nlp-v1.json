    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "lr_scheduler_type": "linear",
    "max_grad_norm": 1.0,
    "seed": 42,
    "optim": "adamw_torch",
    "fp16": false,
    "bf16": false
  },
  "teste_rapido": {
    "amostra_treino": 192,
    "amostra_validacao": 96,
    "num_train_epochs": 1
  }
